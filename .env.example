# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional External Supabase Integration (if syncing with an external Supabase project)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional SMTP Mailer Settings for Scheduled Reports & Receipts
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Webhook HMAC-SHA256 Signing Secret
WEBHOOK_SIGNING_SECRET="orderrestro-webhook-secret"
